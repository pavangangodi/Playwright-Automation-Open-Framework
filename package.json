{
  "name": "surepath-policy-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
